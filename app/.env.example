# Copy to .env.local and adjust.

# Python interpreter used to run the engine pipeline (must have torch,
# transformers, peft, and the training repo's deps importable).
MLORA_PYTHON=python3

# Trained hypernetwork checkpoint (defaults to runs/sixview_v2/head.best.pt).
# MLORA_CHECKPOINT=/abs/path/to/runs/sixview_v2/head.best.pt

# Base model the adapter is generated for (must match the checkpoint). It is
# NOT bundled in this repo — pull it once from the official HF repository:
#   python app/engine/fetch_base_model.py
# MLORA_BASE_MODEL=google/gemma-4-E2B
# MLORA_MODELS_DIR=/abs/path/to/models   # where the snapshot is stored

# Optional: set if you hit HF rate limits (the model itself is public).
# HF_TOKEN=hf_...

# Compute device for the local embedding + merge steps (mps|cuda|cpu).
MLORA_DEVICE=mps

# Base port for served models. Each job gets BASE_PORT + n.
MLORA_BASE_PORT=8000

# Optional bearer key clients must send (leave empty to disable auth).
# MLORA_API_KEY=sk-local-demo
